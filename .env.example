# Copy to .env and fill in OPENAI_API_KEY:  cp .env.example .env

# ---- Server ----
PORT=8000

# Bull Board queue dashboard mount point. NO AUTH — localhost only.
QUEUE_DASHBOARD_PATH=/admin/queues

# ---- Redis (BullMQ queues) ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---- Qdrant (vector store) ----
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=documents

# ---- OpenAI ----
OPENAI_API_KEY=

# text-embedding-3-small -> 1536 dims | text-embedding-3-large -> 3072 dims
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHAT_MODEL=gpt-4o-mini

# ---- Chunking ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ---- Retrieval ----
RETRIEVAL_TOP_K=4
RRF_K=60
RETRIEVAL_FINAL_K=5
